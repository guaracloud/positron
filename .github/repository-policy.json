{
  "schema_version": 1,
  "default_branch": "main",
  "enforcement": "required",
  "pull_request": {
    "required": true,
    "minimum_approvals": 1,
    "require_code_owner_review": true,
    "dismiss_stale_approvals": true,
    "require_last_push_approval": true,
    "require_review_thread_resolution": true
  },
  "required_checks": [
    "Engineering quality / PR gates"
  ],
  "merge_queue": {
    "required": true,
    "workflow_event": "merge_group",
    "strict_current_base": true
  },
  "history": {
    "linear": true,
    "signed_commits": true
  },
  "forbidden": [
    "direct-push",
    "force-push",
    "branch-deletion",
    "administrator-bypass",
    "self-approval",
    "untrusted-check-source",
    "publication-rebuild"
  ]
}
