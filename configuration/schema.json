{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-positron-generated-from": "crates/positron-config/src/contract.rs",
  "title": "Positron Configuration Contract v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "diagnostics": {"type": "object", "additionalProperties": false, "properties": {"log_level": {"type": "string", "enum": ["error", "warn", "info", "debug"]}}},
    "listener": {"type": "object", "additionalProperties": false, "properties": {"control_path": {"type": "string", "maxLength": 256, "x-positron-path-kind": "absolute"}, "operations_bind_address": {"type": "string", "maxLength": 256, "x-positron-address-scope": "loopback-only"}, "api_bind_address": {"type": "string", "maxLength": 256, "x-positron-address-scope": "loopback-only"}, "otlp_grpc_bind_address": {"type": "string", "maxLength": 256, "x-positron-address-scope": "loopback-only"}, "otlp_http_bind_address": {"type": "string", "maxLength": 256, "x-positron-address-scope": "loopback-only"}}},
    "runtime": {"type": "object", "additionalProperties": false, "properties": {"shutdown_grace_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}}},
    "security": {"type": "object", "additionalProperties": false, "properties": {"local_key_file": {"type": "string", "maxLength": 256, "writeOnly": true, "x-positron-runtime-invariant": "storage.secrets_directory/local-root-key.v1"}}},
    "storage": {"type": "object", "additionalProperties": false, "properties": {"data_directory": {"type": "string", "maxLength": 256}, "secrets_directory": {"type": "string", "maxLength": 256}}}
  },
  "required": ["schema_version"]
}
