{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guaracloud/positron/qualification/engineering/evidence.schema.json",
  "title": "Positron engineering gate evidence",
  "$comment": "Constraint owner: tools/xtask/src/quality.rs EVIDENCE_V3_CONSTRAINTS_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "collision_of",
    "collision_slots",
    "profile",
    "result",
    "merge_eligible",
    "source",
    "started_unix_ms",
    "ended_unix_ms",
    "registry_digest",
    "environment_digest",
    "identity",
    "gates"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "attempt_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "collision_of": { "$ref": "#/$defs/identityBinding" },
    "collision_slots": { "$ref": "#/$defs/identityBinding" },
    "profile": { "enum": ["pre-commit", "pr", "ext", "qual"] },
    "result": { "enum": ["passed", "failed"] },
    "merge_eligible": { "type": "boolean" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "dirty", "trusted_ci"],
      "properties": {
        "revision": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
        "dirty": { "type": "boolean" },
        "trusted_ci": { "type": "boolean" }
      }
    },
    "started_unix_ms": { "type": "integer", "minimum": 0 },
    "ended_unix_ms": { "type": "integer", "minimum": 0 },
    "registry_digest": { "$ref": "#/$defs/registryDigest" },
    "environment_digest": { "$ref": "#/$defs/registryDigest" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_manifest",
        "artifact",
        "target",
        "target_registry_digest",
        "toolchain_digest",
        "effective_configuration",
        "fixture_registry_digest",
        "corpus",
        "seed",
        "fault_schedule",
        "verifier",
        "approval",
        "exception"
      ],
      "properties": {
        "release_manifest": { "$ref": "#/$defs/identityBinding" },
        "artifact": { "$ref": "#/$defs/identityBinding" },
        "target": { "$ref": "#/$defs/identityBinding" },
        "target_registry_digest": { "$ref": "#/$defs/registryDigest" },
        "toolchain_digest": { "$ref": "#/$defs/registryDigest" },
        "effective_configuration": { "$ref": "#/$defs/identityBinding" },
        "fixture_registry_digest": { "$ref": "#/$defs/registryDigest" },
        "corpus": { "$ref": "#/$defs/identityBinding" },
        "seed": { "$ref": "#/$defs/identityBinding" },
        "fault_schedule": { "$ref": "#/$defs/identityBinding" },
        "verifier": { "$ref": "#/$defs/identityBinding" },
        "approval": { "$ref": "#/$defs/identityBinding" },
        "exception": { "$ref": "#/$defs/identityBinding" }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "result",
          "duration_ms",
          "budget_seconds",
          "invocation",
          "command_digest",
          "owner",
          "raw_report",
          "detail"
        ],
        "properties": {
          "gate_id": { "type": "string", "pattern": "^EG-(00|[A-Z]+)$" },
          "result": { "enum": ["passed", "failed", "not-selected"] },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "budget_seconds": { "type": "integer", "minimum": 1 },
          "invocation": { "$ref": "#/$defs/gateInvocation" },
          "command_digest": { "$ref": "#/$defs/sha256Digest" },
          "owner": { "$ref": "#/$defs/identityBinding" },
          "raw_report": { "$ref": "#/$defs/rawReportBinding" },
          "detail": { "type": "string", "minLength": 1, "maxLength": 16384 }
        }
      }
    }
  },
  "$defs": {
    "registryDigest": {
      "type": "string",
      "pattern": "^(git-object:[0-9a-f]{40,64}|invalid-registry|unavailable-registry-digest)$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gateInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program",
        "arguments",
        "working_directory",
        "environment_digest",
        "timeout_seconds",
        "memory_mib",
        "activation",
        "exception_class",
        "controlled_steps"
      ],
      "properties": {
        "program": { "const": "cargo-xtask-quality/internal" },
        "arguments": {
          "type": "array",
          "minItems": 3,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "working_directory": { "const": "engineering-workspace" },
        "environment_digest": { "$ref": "#/$defs/sha256Digest" },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "memory_mib": { "type": "integer", "minimum": 1 },
        "activation": { "type": "string", "minLength": 1, "maxLength": 64 },
        "exception_class": { "type": "string", "minLength": 1, "maxLength": 256 },
        "controlled_steps": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/controlledInvocation" }
        }
      }
    },
    "controlledInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program",
        "resolved_program",
        "arguments",
        "working_directory",
        "environment_digest",
        "timeout_ms",
        "input_kind",
        "input_bytes",
        "input_sha256"
      ],
      "properties": {
        "program": { "type": "string", "minLength": 1, "maxLength": 256 },
        "resolved_program": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "arguments": {
          "type": "array",
          "maxItems": 256,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "working_directory": { "const": "engineering-workspace" },
        "environment_digest": { "$ref": "#/$defs/sha256Digest" },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "input_kind": { "enum": ["null", "bytes"] },
        "input_bytes": { "type": "integer", "minimum": 0, "maximum": 8388608 },
        "input_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256Digest" },
            { "const": "-" }
          ]
        }
      }
    },
    "rawReportBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicability",
        "path",
        "sha256",
        "bytes",
        "content_type",
        "reason"
      ],
      "oneOf": [
        {
          "properties": {
            "applicability": { "const": "exact" },
            "path": {
              "type": "string",
              "pattern": "^target/quality/evidence-reports/[A-Za-z0-9._-]{1,256}/EG-(00|[A-Z]+)\\.json$"
            },
            "sha256": { "$ref": "#/$defs/sha256Digest" },
            "bytes": { "type": "integer", "minimum": 1, "maximum": 8388608 },
            "content_type": {
              "const": "application/vnd.positron.quality-gate-report+json;version=1"
            },
            "reason": { "const": "-" }
          }
        },
        {
          "properties": {
            "applicability": { "const": "not-applicable" },
            "path": { "const": "-" },
            "sha256": { "const": "-" },
            "bytes": { "const": 0 },
            "content_type": { "const": "-" },
            "reason": { "const": "gate-not-selected" }
          }
        },
        {
          "properties": {
            "applicability": { "const": "not-applicable" },
            "path": { "const": "-" },
            "sha256": { "const": "-" },
            "bytes": { "const": 0 },
            "content_type": { "const": "-" },
            "reason": { "const": "report-retention-failed" }
          }
        },
        {
          "properties": {
            "applicability": { "const": "not-applicable" },
            "path": { "const": "-" },
            "sha256": { "const": "-" },
            "bytes": { "const": 0 },
            "content_type": { "const": "-" },
            "reason": { "const": "report-encoding-failed" }
          }
        }
      ]
    },
    "identityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability", "value", "reason"],
      "oneOf": [
        {
          "properties": {
            "applicability": { "const": "exact" },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "not": { "const": "-" }
            },
            "reason": { "const": "-" }
          }
        },
        {
          "properties": {
            "applicability": { "const": "not-applicable" },
            "value": { "const": "-" },
            "reason": {
              "enum": [
                "no-collision",
                "no-release-manifest-for-engineering-attempt",
                "no-candidate-artifact-for-engineering-attempt",
                "no-effective-configuration-for-engineering-attempt",
                "no-corpus-selected",
                "no-seed-selected",
                "no-fault-schedule-selected",
                "no-approval-claimed",
                "no-exception-applied",
                "gate-not-selected",
                "unavailable-before-registry-validation"
              ]
            }
          }
        }
      ]
    }
  }
}
