{
  "schema_version": 1,
  "release": "1",
  "state": "specified",
  "qualification_claims_permitted": false,
  "static_targets": [
    {
      "gate": "Q-BUILD-001",
      "targets": [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu"
      ]
    },
    {
      "gate": "Q-API-001",
      "targets": ["grpc", "http-json", "openapi"]
    },
    {
      "gate": "Q-SDK-001",
      "targets": ["rust", "typescript", "python", "go", "java-jvm", "dotnet"]
    },
    {
      "gate": "Q-RX-001",
      "targets": [
        "otlp-grpc-protobuf",
        "otlp-http-protobuf",
        "otlp-http-json"
      ]
    },
    {
      "gate": "Q-RX-002",
      "targets": [
        "otlp-grpc-protobuf",
        "otlp-http-protobuf",
        "otlp-http-json"
      ]
    },
    {
      "gate": "Q-KEY-002",
      "targets": [
        "aws-kms",
        "gcp-kms",
        "azure-key-vault",
        "azure-managed-hsm",
        "vault-transit",
        "openbao-transit",
        "kmip-2.1"
      ]
    },
    {
      "gate": "Q-K8S-002",
      "targets": ["upstream", "eks", "gke", "aks", "openshift", "k3s"]
    }
  ],
  "unresolved_dynamic_selectors": [
    {
      "selector": "maintained-kubernetes-minors-and-patches",
      "gates": ["Q-K8S-001", "Q-K8S-002"],
      "owner": "Kubernetes Platform",
      "required_output": "exact version architecture distribution and StorageClass cells"
    },
    {
      "selector": "named-s3-compatible-products-and-versions",
      "gates": ["Q-BACKUP-001", "Q-BACKUP-002"],
      "owner": "Recovery and Lifecycle",
      "required_output": "exact product version endpoint mode and behavior cells"
    },
    {
      "selector": "producer-and-collector-versions",
      "gates": ["Q-RX-004"],
      "owner": "Ingest Interoperability",
      "required_output": "exact producer package version and fixture cells"
    },
    {
      "selector": "registries-and-package-repositories",
      "gates": ["Q-DIST-001", "Q-DIST-002", "Q-DIST-003", "Q-SUPPLY-001"],
      "owner": "Release Engineering",
      "required_output": "exact registry repository platform and trust cells"
    },
    {
      "selector": "filesystems-docker-volumes-and-storageclasses",
      "gates": ["Q-STORAGE-001"],
      "owner": "Storage Kernel",
      "required_output": "exact implementation version mount options and capability cells"
    },
    {
      "selector": "reference-performance-profiles",
      "gates": ["Q-PERF-001", "Q-SOAK-001"],
      "owner": "Performance Qualification",
      "required_output": "accepted preregistration digests and exact runner identities"
    }
  ],
  "rule": "No unresolved selector may be Implemented or Qualified. Resolving a selector creates a new versioned registry revision; it never edits retained attempt evidence."
}
